generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Professor {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  department String?  @default("Computer Science")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  quizzes    Quiz[]
}

model Quiz {
  id                 String        @id @default(uuid())
  title              String
  description        String?
  timeLimit          Int           @default(30) // default seconds per question if not specified
  shuffleOptions     Boolean       @default(false)
  shuffleQuestions   Boolean       @default(false)
  allowCopyPaste     Boolean       @default(true)
  showLeaderboardLive Boolean      @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  professorId        String
  professor          Professor     @relation(fields: [professorId], references: [id], onDelete: Cascade)
  questions          Question[]
  sessions           QuizSession[]
}

model Question {
  id              String         @id @default(uuid())
  quizId          String
  quiz            Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order           Int            @default(0)
  type            String         // "MCQ", "MULTI_MCQ", "FILL_BLANK", "TRUE_FALSE", "SHORT_ANSWER", "CODING"
  text            String
  codeSnippet     String?
  marks           Int            @default(1)
  timeLimit       Int?           // Optional custom seconds for this question
  acceptedAnswers String?        // JSON string array for FILL_BLANK synonyms e.g. ["O(log n)", "O(logn)", "log n"]
  explanation     String?
  starterCode     String?        // Starter template for CODING questions
  codingLanguage  String?        @default("python") // "python", "javascript", "cpp", "c", "java"

  options         Option[]
  testCases       TestCase[]
  submissions     Submission[]
}

model Option {
  id          String    @id @default(uuid())
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean   @default(false)
  order       Int       @default(0)
}

model TestCase {
  id             String    @id @default(uuid())
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String    // e.g. "hello"
  expectedOutput String    // e.g. "olleh"
  isHidden       Boolean   @default(false)
  explanation    String?
}

model QuizSession {
  id                   String           @id @default(uuid())
  quizId               String
  quiz                 Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  code                 String           @unique // e.g. "X7K92", "ABC12"
  status               String           @default("LOBBY") // "LOBBY", "ACTIVE", "PAUSED", "QUESTION_REVIEW", "ENDED"
  currentQuestionIndex Int              @default(-1)
  questionStartTime    DateTime?
  serverStartTime      DateTime?
  isLeaderboardVisible Boolean          @default(true)
  createdAt            DateTime         @default(now())
  endedAt              DateTime?

  studentSessions      StudentSession[]
  submissions          Submission[]
  results              Result[]
}

model StudentSession {
  id             String        @id @default(uuid())
  sessionId      String
  session        QuizSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  socketId       String?
  name           String
  rollNumber     String
  isOnline       Boolean       @default(true)
  tabSwitchCount Int           @default(0)
  joinedAt       DateTime      @default(now())
  lastActiveAt   DateTime      @default(now())

  submissions    Submission[]
  results        Result[]

  @@unique([sessionId, rollNumber])
}

model Submission {
  id                String            @id @default(uuid())
  sessionId         String
  session           QuizSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentSessionId  String
  studentSession    StudentSession    @relation(fields: [studentSessionId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  answerText        String?           // For Fill blank, Short answer
  selectedOptionIds String?           // JSON array of selected Option IDs e.g. ["opt1", "opt2"]
  isCorrect         Boolean           @default(false)
  marksAwarded      Float             @default(0)
  receivedAt        DateTime          @default(now())
  responseTimeMs    Int               @default(0) // Precise ms elapsed since questionStartTime
  status            String            @default("EVALUATED") // "SUBMITTED", "EVALUATED", "MANUAL_REVIEW"

  codingSubmission  CodingSubmission?

  @@unique([sessionId, studentSessionId, questionId])
}

model CodingSubmission {
  id              String      @id @default(uuid())
  submissionId    String      @unique
  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  language        String
  code            String
  testsPassed     Int         @default(0)
  totalTests      Int         @default(0)
  executionTimeMs Int         @default(0)
  status          String      @default("PENDING") // "PASSED", "FAILED", "COMPILATION_ERROR", "TIMEOUT", "RUNTIME_ERROR"
  stdout          String?
  stderr          String?
  testResults     String?     // JSON array of detailed test results
}

model Result {
  id                String         @id @default(uuid())
  sessionId         String
  session           QuizSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentSessionId  String
  studentSession    StudentSession @relation(fields: [studentSessionId], references: [id], onDelete: Cascade)
  
  totalScore        Float          @default(0)
  totalCorrect      Int            @default(0)
  totalWrong        Int            @default(0)
  totalTimeMs       Int            @default(0)
  avgResponseTimeMs Int            @default(0)
  rank              Int?
  createdAt         DateTime       @default(now())

  @@unique([sessionId, studentSessionId])
}
